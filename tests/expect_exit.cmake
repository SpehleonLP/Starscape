# Runs EXE with the arguments in ARGS ("|"-separated, so paths and flags pass through add_test
# unmangled and any count works) and fails unless it exits with EXPECT. Optional checks:
#   STDERR_CONTAINS  substring stderr must hold (a bare exit code is satisfied by a broken
#                    argument parser as readily as by the intended validation path)
#   ABSENT           path that must not exist afterwards (no half-written output on failure)
string(REPLACE "|" ";" arguments "${ARGS}")
if(DEFINED ABSENT)
	file(REMOVE "${ABSENT}")
endif()
execute_process(COMMAND "${EXE}" ${arguments} RESULT_VARIABLE code ERROR_VARIABLE errors)
if(NOT code EQUAL EXPECT)
	message(FATAL_ERROR "expected exit ${EXPECT}, got ${code}; stderr: ${errors}")
endif()
if(DEFINED STDERR_CONTAINS)
	string(FIND "${errors}" "${STDERR_CONTAINS}" position)
	if(position EQUAL -1)
		message(FATAL_ERROR "stderr lacks '${STDERR_CONTAINS}': ${errors}")
	endif()
endif()
if(DEFINED ABSENT AND EXISTS "${ABSENT}")
	message(FATAL_ERROR "${ABSENT} exists after a failed run")
endif()
