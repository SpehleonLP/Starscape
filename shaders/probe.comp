#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#include "field/step.glsl.h"
#include "philox.glsl"

layout(local_size_x = 64) in;

layout(scalar, set = 0, binding = 0) readonly buffer Galaxies { Galaxy galaxies[]; };
layout(scalar, set = 0, binding = 1) readonly buffer In { uint inputs[]; };
layout(scalar, set = 0, binding = 2) writeonly buffer Out { uint outputs[]; };

layout(push_constant, scalar) uniform Probe
{
	uint     mode;   // 0: lattice hash, 1: Philox, 2: evaluate
	uint     count;
	uint64_t seed;
} probe;

void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if (i >= probe.count)
	{
		return;
	}
	if (probe.mode == 0u)
	{
		// inputs: x, y, z as int64 pairs (low, high)
		const int64_t x = int64_t(uint64_t(inputs[6u * i + 0u]) | (uint64_t(inputs[6u * i + 1u]) << 32));
		const int64_t y = int64_t(uint64_t(inputs[6u * i + 2u]) | (uint64_t(inputs[6u * i + 3u]) << 32));
		const int64_t z = int64_t(uint64_t(inputs[6u * i + 4u]) | (uint64_t(inputs[6u * i + 5u]) << 32));
		outputs[i] = LatticeHash(x, y, z, probe.seed);
	}
	else if (probe.mode == 1u)
	{
		const uvec4 counter = uvec4(inputs[4u * i], inputs[4u * i + 1u], inputs[4u * i + 2u], inputs[4u * i + 3u]);
		const uvec4 block = Philox4x32_10(counter, uvec2(uint(probe.seed), uint(probe.seed >> 32)));
		outputs[4u * i] = block.x;
		outputs[4u * i + 1u] = block.y;
		outputs[4u * i + 2u] = block.z;
		outputs[4u * i + 3u] = block.w;
	}
	else
	{
		// inputs: points as three floats; outputs: count, extinction, gas rgb, then 6 x (density, population)
		const vec3 p = vec3(uintBitsToFloat(inputs[3u * i]), uintBitsToFloat(inputs[3u * i + 1u]), uintBitsToFloat(inputs[3u * i + 2u]));
		GalaxySample result;
		EvaluateLocal(galaxies[0], p, result);
		const uint base = 17u * i;
		outputs[base] = uint(result.count);
		outputs[base + 1u] = floatBitsToUint(result.extinction);
		outputs[base + 2u] = floatBitsToUint(result.gas.x);
		outputs[base + 3u] = floatBitsToUint(result.gas.y);
		outputs[base + 4u] = floatBitsToUint(result.gas.z);
		for (int k = 0; k < 6; ++k)
		{
			outputs[base + 5u + 2u * uint(k)] = k < result.count ? floatBitsToUint(result.parts[k].density) : 0u;
			outputs[base + 6u + 2u * uint(k)] = k < result.count ? uint(result.parts[k].population) : 0u;
		}
	}
}
